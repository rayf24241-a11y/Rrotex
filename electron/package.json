{
  "name": "rotex-editor",
  "version": "1.16.05",
  "description": "ROTEX desktop AI agent for Unity, Roblox, Blender, and game dev projects",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:all": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:win:installer": "node scripts/build-win-installer.js",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "ROTEX",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.rrotex.editor",
    "productName": "ROTEX Desktop",
    "artifactName": "ROTEX-Desktop-${os}.${ext}",
    "afterPack": "./scripts/afterpack.js",
    "asar": true,
    "directories": {
      "output": "../downloads/desktop28"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico"
    ],
    "protocols": [
      {
        "name": "ROTEX",
        "schemes": [
          "rotex"
        ],
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "../docs.html",
        "to": "docs.html"
      },
      {
        "from": "../login.html",
        "to": "login.html"
      },
      {
        "from": "../projects.html",
        "to": "projects.html"
      },
      {
        "from": "../editor.html",
        "to": "editor.html"
      },
      {
        "from": "../editor.css",
        "to": "editor.css"
      },
      {
        "from": "../editor.js",
        "to": "editor.js"
      },
      {
        "from": "../icon.png",
        "to": "icon.png"
      },
      {
        "from": "../favicon.ico",
        "to": "favicon.ico"
      },
      {
        "from": "../plugin/rotex-plugin.lua",
        "to": "plugin/rotex-plugin.lua"
      },
      {
        "from": "../dev-guard.js",
        "to": "dev-guard.js"
      },
      {
        "from": "../desktop-auth.js",
        "to": "desktop-auth.js"
      },
      {
        "from": "../rotex-chats.js",
        "to": "rotex-chats.js"
      },
      {
        "from": "../rotex-tokens.js",
        "to": "rotex-tokens.js"
      },
      {
        "from": "../claude-logo.png",
        "to": "claude-logo.png"
      },
      {
        "from": "../texbrain-logo.png",
        "to": "texbrain-logo.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "publisherName": "ROTEX"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ROTEX"
    },
    "publish": {
      "provider": "github",
      "owner": "rayf24241-a11y",
      "repo": "Rrotex"
    }
  }
}
