{
  "name": "rotex-editor",
  "version": "2.0.0",
  "description": "ROTEX Editor - AI-Powered Code Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "ROTEX",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.rrotex.editor",
    "productName": "ROTEX Editor",
    "directories": {
      "output": "../downloads/desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "../editor.html",
      "../editor.css",
      "../editor.js"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "ROTEX Editor"
    }
  }
}
