{
  "functions": {
    "api/chat.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/editor", "destination": "/index.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/login",   "destination": "/login.html" },
    { "source": "/tokens",  "destination": "/tokens.html" },
    { "source": "/docs",    "destination": "/docs.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/download", "destination": "/#download", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
